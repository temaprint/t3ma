---
import Layout from './Layout.astro';
import siteData from '../data/site.json';

interface Props {
  title: string;
}

const { title } = Astro.props;
const { profile } = siteData;
---

<Layout title={title}>
  <main class="layout">
    <div class="left-column">
      <section class="profile-section">
        <a href="/" class="logo-link">
          <img src={profile.avatar} alt="Artem" class="avatar" />
          <h1 class="logo">{profile.name}</h1>
        </a>

        <p class="tagline">{profile.tagline}</p>

        <div class="social-links">
          {profile.socials.map((social) => (
            <a href={social.url} class="social-link" target="_blank" rel="noopener noreferrer">
              {social.name}
            </a>
          ))}
        </div>
      </section>
    </div>

    <div class="right-column">
      <slot />
    </div>
  </main>
</Layout>

<style>
  .layout {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 2rem;
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  .left-column {
    position: sticky;
    top: 2rem;
    height: fit-content;
  }

  .right-column {
    min-width: 0;
  }

  .profile-section {
    padding: 1.5rem;
  }

  .logo-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    margin-bottom: 1rem;
    transition: opacity 0.2s;
  }

  .logo-link:hover {
    opacity: 0.8;
    text-decoration: none;
  }

  .avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    margin-bottom: 0.75rem;
    object-fit: cover;
    border: 2px solid var(--border);
  }

  .logo {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0;
    color: #fff;
    letter-spacing: -0.01em;
  }

  .tagline {
    color: var(--text-secondary);
    font-size: 0.8rem;
    text-align: center;
    margin-bottom: 1.25rem;
    line-height: 1.5;
  }

  .social-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .social-link {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.8rem;
    padding: 0.35rem 0;
    transition: color 0.2s;
  }

  .social-link:hover {
    color: var(--text);
    text-decoration: none;
  }

  @media (max-width: 768px) {
    .layout {
      grid-template-columns: 1fr;
    }

    .left-column {
      position: static;
    }
  }
</style>
